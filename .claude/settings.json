{
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:integration)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm test:db)",
      "Bash(pnpm build)",
      "Bash(pnpm perf)",
      "Bash(pnpm db:types)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm supabase status*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git merge *)",
      "Bash(git worktree *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(pnpm supabase db push*)",
      "Bash(pnpm supabase db reset*)",
      "Bash(pnpm supabase start*)",
      "Bash(pnpm supabase stop*)",
      "Bash(pnpm supabase link*)",
      "Bash(pnpm supabase * --remote*)",
      "Bash(pnpm supabase * --linked*)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)", "Bash(cat .env*)"]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/implementer-checks.sh",
            "timeout": 600,
            "statusMessage": "Running typecheck, lint and tests for the implementer"
          }
        ]
      }
    ]
  }
}
