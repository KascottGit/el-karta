{
  "name": "el-karta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @el-karta/web dev",
    "build": "pnpm --recursive --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --recursive typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "perf": "pnpm --filter @el-karta/core perf",
    "supabase": "supabase",
    "db:types": "supabase gen types --local --schema public > packages/data-supabase/src/database.types.ts && prettier --write packages/data-supabase/src/database.types.ts",
    "test:db": "supabase test db",
    "test:integration": "INTEGRATION=1 vitest run --project integration",
    "test:e2e": "playwright test -c apps/web/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supabase": "^3.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
